{
  "name": "ai-kernel-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local parallel AI terminal workspace for Windows and Linux",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:cli": "node scripts/cli-smoke.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "test:package": "node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}
